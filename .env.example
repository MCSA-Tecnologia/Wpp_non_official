# ============================================================
# AutoWpp 2 - configuracao (.env)
# Copie este arquivo para .env e preencha o necessario.
# Tudo tem default seguro - o projeto roda com .env vazio
# usando CSV/XLSX (sem banco).
# ============================================================

# --- Disparo ---
MAX_ACCOUNTS=6
MIN_SEND_DELAY_MS=20000
MAX_SEND_DELAY_MS=45000
ACK_GRACE_MS=30000
SEND_INACTIVITY_TIMEOUT_MS=300000
AUTH_TIMEOUT_SECONDS=240
AUTH_MAX_RETRIES=2
VALIDATE_NUMBERS=True
DEFAULT_COUNTRY_CODE=55

# --- Mensagem padrao (pode sobrescrever pela interface/CLI) ---
#CONTACT_MESSAGE=Bom dia NOME_DO_CLIENTE, ...
#CONTACT_BUTTON_URL=https://wa.me/5531...?text=...

# --- Banco SQL Server (opcional - so para carga via banco) ---
SERVER=
DATABASE=
DBUSERNAME=
PASSWORD=
ODBC_DRIVER=ODBC Driver 17 for SQL Server

# --- RO / Calltech ---
RO_ENABLED=True
RO_CALLTECH_ENDPOINT=https://calltechsmart.kinghost.net/portal/registrarResumo
RO_TIMEOUT_SECONDS=60
RO_TRIGGER_MIN_COUNT=100
RO_BATCH_SIZE=390
RO_RESUMO_ID=12
RO_OPERADOR_ID=227
RO_CODIGO_CAMPANHA=000000
RO_CAMPANHA_ID=0
RO_ORIGEM=API - Whatsapp Unofficial
RO_PARCEIRO=API Whatsapp Unofficial

# --- Relatorio de erro (opcional) ---
ERROR_REPORT_URL=
ERROR_REPORT_AUTH_TOKEN=
ERROR_REPORT_HEADER_KEY=
ERROR_REPORT_HEADER_VALUE=

# --- Frontend ---
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=8502

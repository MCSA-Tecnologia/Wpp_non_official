# Gere valores exclusivos antes de executar em produção.
AUTOWPP_JWT_SECRET=replace-with-at-least-32-random-characters
# Fernet key, gerada com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AUTOWPP_ENCRYPTION_KEY=
AUTOWPP_WORKER_TOKEN=replace-with-an-independent-worker-token
AUTOWPP_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
AUTOWPP_BOOTSTRAP_ADMIN_PASSWORD=replace-this-password
AUTOWPP_COOKIE_SECURE=false
AUTOWPP_CORS_ORIGINS=http://localhost:8080

# Em produção, defina estes valores diretamente no serviço de API:
# AUTOWPP_DATABASE_URL=postgresql+psycopg://user:password@managed-postgres:5432/autowpp
# AUTOWPP_REDIS_URL=rediss://managed-redis:6379/0

# SQL Server somente-leitura, usado exclusivamente pelo botão de exportação.
AUTOWPP_SOURCE_SQL_SERVER=
AUTOWPP_SOURCE_SQL_DATABASE=
AUTOWPP_SOURCE_SQL_USERNAME=
AUTOWPP_SOURCE_SQL_PASSWORD=

# Registro RO assíncrono.
AUTOWPP_RO_ENABLED=false
AUTOWPP_RO_ENDPOINT=
